{
  "name": "zentify-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @zentify/core",
    "build:vite": "npm run build -w @zentify/vite",
    "build:react": "npm run build -w @zentify/react",
    "build:all": "npm run build:core && npm run build:react && npm run build:vite"
  }
}
