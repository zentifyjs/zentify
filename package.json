{
  "name": "zentify",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @zentify/core",
    "build:vite": "npm run build -w @zentify/vite",
    "build:react": "npm run build -w @zentify/react",
    "build:typeorm": "npm run build -w @zentify/typeorm",
    "build:all": "npm run build:core && npm run build:react && npm run build:vite && npm run build:typeorm"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
