{
  "name": "@zentify/typeorm",
  "version": "1.1.0-rc-15",
  "description": "TypeORM integration for Zentify",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@zentify/core": "*",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zentify/core": "*",
    "typeorm": "^0.3.0",
    "typescript": "^5.0.0"
  },
  "author": "",
  "license": "ISC"
}
