{
  "name": "@zentify/core",
  "version": "1.1.0-rc-13",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "zentify": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently --raw \"tsc --watch\" \"node --watch dist/main.js\"",
    "start": "tsx src/index.ts",
    "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --clean --shims && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/cli/index.js": {
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/serve-static": "^2.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@swc/core": "^1.15.47",
    "@vercel/nft": "^0.27.10",
    "busboy": "^1.6.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "find-my-way": "^9.7.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "reflect-metadata": "^0.2.2",
    "serve-static": "^2.2.1",
    "valibot": "^1.4.2"
  }
}
