{
  "name": "@zentify/core",
  "version": "1.0.6-rc-2",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "bin": {
    "zentify": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently --raw \"tsc --watch\" \"node --watch dist/main.js\"",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "build:cjs": "tsc && node scripts/build-cjs.cjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/cli/index.js": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.2.0",
    "@types/serve-static": "^2.2.0",
    "concurrently": "^10.0.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "busboy": "^1.6.0",
    "commander": "^15.0.0",
    "find-my-way": "^9.7.0",
    "picocolors": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "serve-static": "^2.2.1",
    "valibot": "^0.42.1"
  }
}
