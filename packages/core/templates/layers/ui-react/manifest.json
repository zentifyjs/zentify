{
  "name": "React + Vite",
  "description": "Adds a React + Vite frontend",
  "kind": "layer",
  "deps": {
    "dependencies": {
      "@zentify/react": "*",
      "@zentify/vite": "*",
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    },
    "devDependencies": {
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0",
      "@vitejs/plugin-react": "^4.2.1",
      "vite": "^6.4.3",
      "glob": "^13.0.0"
    }
  },
  "imports": [
    "import { render } from \"@zentify/core\";",
    "import { ZentifyViteAdapter } from \"@zentify/vite\";"
  ],
  "bootstrap": "app.addAdapter(new ZentifyViteAdapter());",
  "marker": "// [[zentify:vite]]"
}
